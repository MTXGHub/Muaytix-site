+  const table = '[' + PACKED.map(([code, phrase]) => '"' + code + '","' + phrase + '"').join(',') + ']';
+  return '(function(s,d){for(var i=0;i<d.length;i+=2)s=s.split(d[i]).join(d[i+1]);return s})(' + packed + ',' + table + ')';
